{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteSyntheticFounderTestLeads",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db",
        "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db/index/email-index"
      ]
    },
    {
      "Sid": "CleanEligibleInvitersMirrorTestRows",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-eligible-inviters"
    },
    {
      "Sid": "SendFounderTestEmails",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ses:us-east-1:343218208384:identity/presttige.net",
        "arn:aws:ses:us-east-1:343218208384:identity/committee@presttige.net"
      ]
    },
    {
      "Sid": "ReadTestConfigAndDirectusToken",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:us-east-1:343218208384:parameter/presttige/founder-invite/test-delay-minutes",
        "arn:aws:ssm:us-east-1:343218208384:parameter/ulttra/directus/codex-token"
      ]
    },
    {
      "Sid": "ManageFounderTestSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": [
        "arn:aws:scheduler:us-east-1:343218208384:schedule/default/presttige-founder-test-*"
      ]
    },
    {
      "Sid": "ListFounderTestSchedules",
      "Effect": "Allow",
      "Action": "scheduler:ListSchedules",
      "Resource": "*"
    },
    {
      "Sid": "PassFounderTestSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::343218208384:role/presttige-founder-test-harness-scheduler-role"
    },
    {
      "Sid": "WriteOwnLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:343218208384:log-group:/aws/lambda/presttige-founder-test-harness",
        "arn:aws:logs:us-east-1:343218208384:log-group:/aws/lambda/presttige-founder-test-harness:*"
      ]
    }
  ]
}
