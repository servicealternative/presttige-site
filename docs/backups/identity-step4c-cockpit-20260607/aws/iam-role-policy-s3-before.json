{
    "RoleName": "ulttra-crm-directus-task-role",
    "PolicyName": "ulttra-crm-directus-s3-files",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket"
                ],
                "Resource": "arn:aws:s3:::ulttra-crm-files"
            },
            {
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                ],
                "Resource": "arn:aws:s3:::ulttra-crm-files/*"
            }
        ]
    }
}
