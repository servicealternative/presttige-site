{
    "RoleName": "presttige-member-set-password-role",
    "PolicyName": "presttige-member-set-password-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                ],
                "Resource": "arn:aws:logs:us-east-1:343218208384:*"
            },
            {
                "Effect": "Allow",
                "Action": [
                    "dynamodb:Query",
                    "dynamodb:Scan",
                    "dynamodb:UpdateItem"
                ],
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db",
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db/index/*"
                ]
            },
            {
                "Effect": "Allow",
                "Action": [
                    "cognito-idp:AdminGetUser",
                    "cognito-idp:AdminSetUserPassword"
                ],
                "Resource": "arn:aws:cognito-idp:us-east-1:343218208384:userpool/us-east-1_hpwdNFGss"
            },
            {
                "Effect": "Allow",
                "Action": "ses:SendEmail",
                "Resource": "*",
                "Condition": {
                    "StringEquals": {
                        "ses:FromAddress": "private@presttige.net"
                    }
                }
            }
        ]
    }
}
