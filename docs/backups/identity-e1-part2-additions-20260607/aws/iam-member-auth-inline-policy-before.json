{
    "RoleName": "presttige-member-auth-role",
    "PolicyName": "presttige-member-auth-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "CloudWatchLogs",
                "Effect": "Allow",
                "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                ],
                "Resource": "arn:aws:logs:us-east-1:343218208384:*"
            },
            {
                "Sid": "ReadPresttigeMemberRecords",
                "Effect": "Allow",
                "Action": [
                    "dynamodb:Query"
                ],
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db/index/cognito_sub-index",
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db/index/email-index"
                ]
            },
            {
                "Sid": "MemberPoolPasswordAuth",
                "Effect": "Allow",
                "Action": [
                    "cognito-idp:AdminInitiateAuth",
                    "cognito-idp:GetUser",
                    "cognito-idp:InitiateAuth",
                    "cognito-idp:ForgotPassword",
                    "cognito-idp:ConfirmForgotPassword"
                ],
                "Resource": "arn:aws:cognito-idp:us-east-1:343218208384:userpool/us-east-1_hpwdNFGss"
            },
            {
                "Sid": "SyntheticResetNoticeToFQ",
                "Effect": "Allow",
                "Action": "ses:SendEmail",
                "Resource": "*",
                "Condition": {
                    "StringEquals": {
                        "ses:FromAddress": "private@presttige.net"
                    }
                }
            },
            {
                "Sid": "WriteOwnPresttigeMemberProfile",
                "Effect": "Allow",
                "Action": [
                    "dynamodb:UpdateItem"
                ],
                "Resource": "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db"
            },
            {
                "Sid": "MemberPhotoUploadInit",
                "Effect": "Allow",
                "Action": "lambda:InvokeFunction",
                "Resource": "arn:aws:lambda:us-east-1:343218208384:function:presttige-photo-upload-init"
            },
            {
                "Sid": "ReadOwnMemberPhotoThumbnails",
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::presttige-applicant-photos-thumbnails/*"
            },
            {
                "Sid": "DecryptPhotoThumbnails",
                "Effect": "Allow",
                "Action": "kms:Decrypt",
                "Resource": "arn:aws:kms:us-east-1:343218208384:key/723bb788-9911-4c49-bf1d-792b73685e7c"
            },
            {
                "Sid": "AppendMemberDsarAudit",
                "Effect": "Allow",
                "Action": "dynamodb:PutItem",
                "Resource": "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-review-audit"
            },
            {
                "Sid": "EraseOwnMemberPhotos",
                "Effect": "Allow",
                "Action": "s3:DeleteObject",
                "Resource": [
                    "arn:aws:s3:::presttige-applicant-photos/*",
                    "arn:aws:s3:::presttige-applicant-photos-thumbnails/*"
                ]
            },
            {
                "Sid": "ErasePresttigeMemberCognitoUser",
                "Effect": "Allow",
                "Action": [
                    "cognito-idp:AdminDisableUser",
                    "cognito-idp:AdminDeleteUser"
                ],
                "Resource": "arn:aws:cognito-idp:us-east-1:343218208384:userpool/us-east-1_hpwdNFGss"
            },
            {
                "Sid": "FounderSoftwareTokenMfa",
                "Effect": "Allow",
                "Action": [
                    "cognito-idp:AssociateSoftwareToken",
                    "cognito-idp:VerifySoftwareToken",
                    "cognito-idp:AdminRespondToAuthChallenge",
                    "cognito-idp:AdminSetUserMFAPreference"
                ],
                "Resource": "arn:aws:cognito-idp:us-east-1:343218208384:userpool/us-east-1_hpwdNFGss"
            },
            {
                "Sid": "MemberDiscoveryPresttigeDbReadByLeadId",
                "Effect": "Allow",
                "Action": [
                    "dynamodb:GetItem"
                ],
                "Resource": "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-db"
            },
            {
                "Sid": "MemberDiscoverySwitchRead",
                "Effect": "Allow",
                "Action": [
                    "ssm:GetParameter"
                ],
                "Resource": "arn:aws:ssm:us-east-1:343218208384:parameter/presttige/member-discovery/enabled"
            },
            {
                "Sid": "MemberDiscoveryStateAccess",
                "Effect": "Allow",
                "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                ],
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-discovery-state",
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-discovery-state/index/visibility-index"
                ]
            },
            {
                "Sid": "MemberDiscoveryConnectionsAccess",
                "Effect": "Allow",
                "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                ],
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-connections",
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-connections/index/target-index"
                ]
            },
            {
                "Sid": "MemberDiscoveryMatchesAccess",
                "Effect": "Allow",
                "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:Query"
                ],
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-matches",
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-matches/index/member-a-index",
                    "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-matches/index/member-b-index"
                ]
            },
            {
                "Sid": "MemberDiscoveryMessagesAccess",
                "Effect": "Allow",
                "Action": [
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                ],
                "Resource": "arn:aws:dynamodb:us-east-1:343218208384:table/presttige-member-messages"
            }
        ]
    }
}
